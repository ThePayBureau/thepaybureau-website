---
import BaseLayout from '../layouts/BaseLayout.astro';
const FORM_ENDPOINT = 'https://script.google.com/macros/s/AKfycbz99qqWV5i5eUn0ul5ho0tB_OExA-gXhmIodQz1xv2GlpraaxZ_Q6xKq830ucUhnQ-4/exec';
---
<BaseLayout title="Contact — ThePayBureau" description="Get in touch with ThePayBureau. Questions about the product, pricing, security or your bureau — we respond within 24 hours." path="/contact">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">CONTACT</span>
      <h1>Talk to us</h1>
      <p>Questions about the product, pricing, security or getting your bureau set up? Send us a message — we respond within 24 hours.</p>
    </div>
  </section>

  <section class="section-lg">
    <div class="wrap">
      <form class="form" id="contact-form" data-endpoint={FORM_ENDPOINT} novalidate>
        <div class="field">
          <label for="name">Full name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="email">Business email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="company">Bureau / company name</label>
          <input id="company" name="company" type="text" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="message">How can we help?</label>
          <textarea id="message" name="message" rows="4" required></textarea>
        </div>
        <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="btn btn-primary" type="submit">Send message</button>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      </form>
      <p class="contact-alt">Prefer email? Reach us directly at <a href="mailto:support@thepaybureau.com">support@thepaybureau.com</a></p>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const status = document.getElementById('form-status');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (form.website.value) return; // honeypot
      if (!form.name.value || !form.email.value.includes('@') || !form.message.value) {
        status.textContent = 'Please add your name, a valid email and a message.';
        status.className = 'form-status err';
        return;
      }
      const btn = form.querySelector('button[type=submit]');
      btn.disabled = true; btn.textContent = 'Sending…';
      status.textContent = '';
      try {
        await fetch(form.dataset.endpoint, {
          method: 'POST', mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: form.name.value, email: form.email.value,
            company: form.company.value, message: form.message.value,
            source: 'contact_form', formType: 'contact',
            timestamp: new Date().toISOString(),
            userAgent: navigator.userAgent, referrer: document.referrer,
          }),
        });
        form.reset();
        status.textContent = 'Thanks — we’ve got your message and will reply within 24 hours.';
        status.className = 'form-status ok';
      } catch {
        status.textContent = 'Something went wrong. Please email support@thepaybureau.com instead.';
        status.className = 'form-status err';
      } finally {
        btn.disabled = false; btn.textContent = 'Send message';
      }
    });
  </script>
</BaseLayout>
