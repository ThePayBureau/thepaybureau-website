---
import BaseLayout from '../layouts/BaseLayout.astro';
// Web3Forms — replace with the access key generated at web3forms.com for support@thepaybureau.com.
// The key is safe to expose in the frontend (it only routes submissions to that inbox).
const WEB3FORMS_KEY = 'fc3deebd-b00f-407d-b6d0-e322a3d8e34b';
---
<BaseLayout title="Contact — ThePayBureau" description="Get in touch with ThePayBureau. Questions about the product, pricing, security or your bureau — we respond within 24 hours." path="/contact">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">CONTACT</span>
      <h1>Talk to us</h1>
      <p>Questions about the product, pricing, security or getting your bureau set up? Send us a message — we respond within 24 hours.</p>
    </div>
  </section>

  <section class="section-lg">
    <div class="wrap">
      <form class="form" id="contact-form" data-key={WEB3FORMS_KEY} novalidate>
        <div class="field">
          <label for="name">Full name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="email">Business email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="company">Bureau / company name</label>
          <input id="company" name="company" type="text" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="message">How can we help?</label>
          <textarea id="message" name="message" rows="4" required></textarea>
        </div>
        <input class="hp" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="btn btn-primary" type="submit">Send message</button>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      </form>
      <p class="contact-alt">Prefer email? Reach us directly at <a href="mailto:support@thepaybureau.com">support@thepaybureau.com</a></p>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const status = document.getElementById('form-status');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (form.botcheck.checked) return; // honeypot
      if (!form.name.value || !form.email.value.includes('@') || !form.message.value) {
        status.textContent = 'Please add your name, a valid email and a message.';
        status.className = 'form-status err';
        return;
      }
      const btn = form.querySelector('button[type=submit]');
      btn.disabled = true; btn.textContent = 'Sending…';
      status.textContent = '';
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: form.dataset.key,
            subject: 'New enquiry from thepaybureau.com',
            from_name: 'ThePayBureau website',
            name: form.name.value,
            email: form.email.value,
            company: form.company.value,
            message: form.message.value,
          }),
        });
        const data = await res.json();
        if (data.success) {
          form.reset();
          status.textContent = 'Thanks — we’ve got your message and will reply within 24 hours.';
          status.className = 'form-status ok';
        } else {
          throw new Error(data.message || 'failed');
        }
      } catch {
        status.textContent = 'Something went wrong. Please email support@thepaybureau.com instead.';
        status.className = 'form-status err';
      } finally {
        btn.disabled = false; btn.textContent = 'Send message';
      }
    });
  </script>
</BaseLayout>
