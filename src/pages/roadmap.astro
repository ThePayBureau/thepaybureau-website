---
import BaseLayout from '../layouts/BaseLayout.astro';

const tiers = [
  {
    name: 'Free', price: '£0, forever', popular: false,
    sub: 'Everything a payroll consultant needs to get started. Unlimited clients · up to 50 active payrolls.',
    groups: [
      { label: 'Included', kind: 'live', items: [
        'Client Management (unlimited)', 'Payroll Management (up to 50 active payrolls)', 'Pension Declarations',
        'CSV Import & Export', 'Basic Audit Trail', 'Live Dashboard Metrics', 'Email Support',
      ] },
    ],
  },
  {
    name: 'Unlimited', price: '£19–24 / user / mo', popular: true,
    sub: 'Everything in Free, plus — removes the 50-payroll cap.',
    groups: [
      { label: 'Included', kind: 'live', items: [
        'Unlimited active payrolls', 'Penny — Payroll AI Assistant', 'Training Module',
        'Automated Email Reminders', 'Headline Metrics',
      ] },
    ],
  },
  {
    name: 'Bureau', price: '£29–35 / user / mo', popular: false,
    sub: 'Everything in Unlimited, plus the tools to run a proper payroll operation.',
    groups: [
      { label: 'Live today', kind: 'live', items: [
        'Bureau / Team Dashboard', 'Financial Insights', 'Capacity Insights', 'Service Delivery Insights',
        'Client Health Insights', 'Organisation Chart', 'Priority Support',
      ] },
      { label: 'Planned', kind: 'planned', items: [
        'Client Onboarding', 'Contracts & Engagement Letters', 'E-signatures', 'AML / KYC Checks',
      ] },
    ],
  },
  {
    name: 'Enterprise', price: 'Pricing on application', popular: false,
    sub: 'Everything in Bureau, plus advanced forecasting, benchmarking and commercial tooling.',
    groups: [
      { label: 'Live today', kind: 'live', items: [
        'Capacity Forecasting', 'Revenue Forecasting', 'Churn Risk Scoring',
        'Peer Benchmarking / Bureau Comparison', 'Advanced Fee Management',
      ] },
      { label: 'Planned', kind: 'planned', items: [
        'Client Surveys / NPS', 'Team Performance Reviews', 'White Labelling',
      ] },
    ],
  },
];
---

<BaseLayout title="Roadmap — ThePayBureau" description="The UK’s first payroll CRM, powered by AI. See exactly what’s live today and what’s coming next across Free, Unlimited, Bureau and Enterprise." path="/roadmap">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">PRODUCT ROADMAP</span>
      <h1>What’s live today, and what’s <span class="clip">coming next</span></h1>
      <p>The UK’s first payroll CRM, powered by AI — built with and for the payroll community. Every plan, every feature, laid out honestly.</p>
    </div>
  </section>

  <section class="section-lg">
    <div class="wrap">
      <div class="rlegend">
        <span class="k"><span class="s live"></span> Live today</span>
        <span class="k"><span class="s plan"></span> Planned</span>
      </div>

      {tiers.map((t) => (
        <div class="rtier">
          <div class="rhead">
            <div>
              {t.popular && <span class="popular">Most popular</span>}
              <h3 style="margin-top:8px">{t.name}</h3>
            </div>
            <span class="rprice">{t.price}</span>
          </div>
          <p class="rdesc">{t.sub}</p>
          {t.groups.map((g) => (
            <>
              <h4>{g.label}</h4>
              <div class="pills">
                {g.items.map((it) => (
                  <span class={g.kind === 'planned' ? 'pill-tag planned' : 'pill-tag live'}>
                    <span class="mk">{g.kind === 'planned' ? '🔜' : '✓'}</span>{it}
                  </span>
                ))}
              </div>
            </>
          ))}
        </div>
      ))}

      <p class="pricing-note" style="margin-top:30px">This roadmap evolves with customer and community feedback — your voice shapes what we build next. See <a href="/pricing">full pricing →</a></p>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <h2>Ready to simplify your payroll bureau?</h2>
      <p>Free forever for individuals. No credit card required.</p>
      <a class="btn btn-primary btn-lg" href="https://app.thepaybureau.com/signup">Get started free</a>
    </div>
  </section>
</BaseLayout>
