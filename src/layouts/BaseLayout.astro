---
// Self-hosted fonts (no runtime Google Fonts — perf + GDPR)
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/dm-serif-display/400.css';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

export interface Props {
  title?: string;
  description?: string;
  path?: string;
  /** Extra JSON-LD graphs, emitted after the Organization graph. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Set while a page is provisional/unpublished. */
  noindex?: boolean;
}

const {
  title = 'BureauFlow — The Payroll CRM That Runs Your Bureau For You',
  description = 'The UK’s first payroll CRM, powered by AI. Track every HMRC deadline, manage every client, and tick off every checklist — all from one dashboard. Free forever for individuals.',
  path = '/',
  jsonLd,
  noindex = false,
} = Astro.props;

const graphs = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// JSON-LD inside <script> must not be able to close the tag. orgJsonLd is
// static so this never mattered; comparison data is externally supplied.
const ld = (o: unknown) =>
  JSON.stringify(o).replace(/</g, '\\u003c').replace(/[\u2028\u2029]/g, '');

const site = 'https://www.bureauflow.co.uk';
const canonical = new URL(path, site).href;
const nav = [
  { label: 'Features', href: '/#features' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Roadmap', href: '/roadmap' },
  { label: 'Security', href: '/security' },
];
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'BureauFlow',
  legalName: 'BureauFlow Limited',
  url: site,
  logo: `${site}/bureauflow-logo-full.png`,
  email: 'support@bureauflow.co.uk',
  areaServed: 'GB',
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/bureauflow-icon.svg" />
    <link rel="apple-touch-icon" href="/bureauflow-apple-touch-icon-180.png" />
    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BureauFlow" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/bureauflow-og-1200x630.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/bureauflow-og-1200x630.png`} />
    <meta name="theme-color" content="#401D6C" />
    <script type="application/ld+json" set:html={ld(orgJsonLd)} />
    {graphs.map((g) => <script type="application/ld+json" set:html={ld(g)} />)}
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <header class="site-header">
      <div class="wrap nav">
        <a href="/" aria-label="BureauFlow home">
          <img src="/bureauflow-logo-full.png" alt="BureauFlow" class="logo" width="138" height="30" />
        </a>
        <nav class="navlinks" aria-label="Primary">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
        <div class="nav-cta">
          <a class="btn btn-line" href="https://app.bureauflow.co.uk/login">Log in</a>
          <a class="btn btn-primary" href="https://app.bureauflow.co.uk/signup">Start Free</a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-about">
            <img src="/bureauflow-logo-full.png" alt="BureauFlow" width="129" height="28" />
            <p>Built by payroll professionals, for payroll professionals.</p>
          </div>
          <div>
            <h4>Product</h4>
            <a href="/#features">Features</a>
            <a href="/pricing">Pricing</a>
            <a href="/roadmap">Roadmap</a>
            <a href="/security">Security</a>
            <a href="/compare/">Compare</a>
          </div>
          <div>
            <h4>Company</h4>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
            <a href="mailto:support@bureauflow.co.uk">Support</a>
          </div>
          <div>
            <h4>Legal</h4>
            <a href="/privacy">Privacy Policy</a>
            <a href="/terms">Terms of Service</a>
            <a href="/dpa">Data Processing Agreement</a>
            <a href="/security">Security</a>
            <a href="/anti-bribery">Anti-Bribery Policy</a>
            <a href="/service-overview">Service Overview</a>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© 2026 BureauFlow Limited. Registered in England and Wales. Company number 17378706.</span>
          <span>UK built &amp; hosted</span>
        </div>
      </div>
    </footer>

    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged screenshot">
      <button class="lb-close" type="button" aria-label="Close">✕</button>
      <img src="" alt="" />
    </div>

    <Analytics />

    <script is:inline>
      // Billing period toggle (monthly / annual). Both prices are in the static
      // HTML via data-mo / data-yr; this only switches which is shown.
      document.querySelectorAll('.billing-toggle').forEach((tg) => {
        const scope = tg.closest('[data-billing]') || document;
        tg.querySelectorAll('button').forEach((b) => {
          b.addEventListener('click', () => {
            const annual = b.dataset.cycle === 'annual';
            tg.querySelectorAll('button').forEach((x) => {
              const on = x === b;
              x.classList.toggle('active', on);
              x.setAttribute('aria-pressed', String(on));
            });
            scope.querySelectorAll('.amt').forEach((a) => {
              a.textContent = annual ? a.dataset.yr : a.dataset.mo;
            });
            scope.querySelectorAll('[data-annual-only]').forEach((n) => { n.hidden = !annual; });
          });
        });
      });

      // Image lightbox — click any screenshot to view it larger. Progressive
      // enhancement only; the images are already in the static HTML.
      (function () {
        const lb = document.getElementById('lightbox');
        if (!lb) return;
        const lbImg = lb.querySelector('img');
        const closeBtn = lb.querySelector('.lb-close');
        let lastFocus = null;
        const open = (src, alt) => {
          lbImg.src = src; lbImg.alt = alt || '';
          lb.classList.add('open');
          lastFocus = document.activeElement;
          closeBtn.focus();
          document.documentElement.style.overflow = 'hidden';
        };
        const close = () => {
          lb.classList.remove('open'); lbImg.src = '';
          document.documentElement.style.overflow = '';
          if (lastFocus && lastFocus.focus) lastFocus.focus();
        };
        document.querySelectorAll('.shot img').forEach((img) => {
          img.setAttribute('role', 'button');
          img.setAttribute('tabindex', '0');
          img.setAttribute('aria-label', (img.alt || 'Screenshot') + ' — enlarge');
          img.addEventListener('click', () => open(img.currentSrc || img.src, img.alt));
          img.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(img.currentSrc || img.src, img.alt); }
          });
        });
        lb.addEventListener('click', (e) => { if (e.target === lb || e.target === closeBtn) close(); });
        closeBtn.addEventListener('click', close);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && lb.classList.contains('open')) close(); });
      })();
    </script>
  </body>
</html>
